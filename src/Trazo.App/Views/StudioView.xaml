<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Trazo.App.Views.StudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsTabStop="True"
    FontFamily="{StaticResource TrazoUiFont}"
    PreviewKeyDown="OnPreviewKeyDown"
    KeyUp="OnKeyUp">

    <Grid x:Name="Stage" Background="{StaticResource StageBrush}">

        <win2d:CanvasControl x:Name="Canvas"
                             UseSharedDevice="True"
                             ClearColor="#FF2A2B2F"
                             Draw="Canvas_Draw"
                             ManipulationMode="None"
                             IsHoldingEnabled="False"
                             IsRightTapEnabled="False"
                             IsDoubleTapEnabled="False"
                             IsTabStop="True"
                             PointerPressed="Canvas_PointerPressed"
                             PointerMoved="Canvas_PointerMoved"
                             PointerReleased="Canvas_PointerReleased"
                             PointerCanceled="Canvas_PointerCanceled"
                             PointerCaptureLost="Canvas_PointerCanceled"
                             PointerExited="Canvas_PointerExited"
                             PointerWheelChanged="Canvas_PointerWheelChanged" />

        <!-- Barra superior -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Height="52" Padding="8,0" Background="{StaticResource BarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Content="Galería" Click="Gallery_Click" Height="44" Padding="12,0" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" ToolTipService.ToolTip="Volver a la galería" />
                <Button x:Name="ActionsButton" Style="{StaticResource BarButton}" ToolTipService.ToolTip="Acciones">
                    <FontIcon Glyph="&#xE90F;" FontSize="20" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="ActionsMenu" Placement="BottomEdgeAlignedLeft" Opening="ActionsMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="AdjustButton" Style="{StaticResource BarButton}" ToolTipService.ToolTip="Ajustes">
                    <FontIcon Glyph="&#xE9E9;" FontSize="20" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AdjustMenu" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="TransformButton" Style="{StaticResource BarToggle}" Click="Transform_Click" ToolTipService.ToolTip="Transformar (V)">
                    <FontIcon Glyph="&#xE7C2;" FontSize="20" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="BrushButton" Style="{StaticResource BarToggle}" Click="Tool_Click" Tag="Brush" ToolTipService.ToolTip="Pintar (B) · toca de nuevo para la biblioteca">
                    <FontIcon Glyph="&#xEE56;" FontSize="20" />
                </ToggleButton>
                <ToggleButton x:Name="SmudgeButton" Style="{StaticResource BarToggle}" Click="Tool_Click" Tag="Smudge" ToolTipService.ToolTip="Difuminar (S)">
                    <FontIcon Glyph="&#xED5F;" FontSize="20" />
                </ToggleButton>
                <ToggleButton x:Name="EraserButton" Style="{StaticResource BarToggle}" Click="Tool_Click" Tag="Eraser" ToolTipService.ToolTip="Borrar (E)">
                    <FontIcon Glyph="&#xE75C;" FontSize="20" />
                </ToggleButton>
                <Button x:Name="LayersButton" Style="{StaticResource BarButton}" Click="Layers_Click" ToolTipService.ToolTip="Capas (L)">
                    <FontIcon Glyph="&#xE81E;" FontSize="20" />
                </Button>
                <Button x:Name="ColorButton" Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="22"
                        Click="Color_Click" ToolTipService.ToolTip="Color (C) · arrastra al lienzo para rellenar">
                    <Ellipse x:Name="ColorSwatch" Width="32" Height="32" Stroke="#FFF2F2F4" StrokeThickness="3" Fill="Black" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barra lateral -->
        <Border x:Name="SideBar" HorizontalAlignment="Left" VerticalAlignment="Center" Width="56" Padding="0,12"
                Background="{StaticResource BarBrush}" CornerRadius="0,16,16,0">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Slider x:Name="SizeSlider" Orientation="Vertical" Height="170" Minimum="0" Maximum="1000" StepFrequency="1"
                        IsThumbToolTipEnabled="False" ValueChanged="SizeSlider_ValueChanged" ToolTipService.ToolTip="Tamaño" />
                <TextBlock x:Name="SizeLabel" FontSize="11" HorizontalAlignment="Center" Opacity="0.7" />
                <ToggleButton x:Name="EyedropperButton" Style="{StaticResource BarToggle}" Click="Eyedropper_Click" ToolTipService.ToolTip="Cuentagotas (I)">
                    <FontIcon Glyph="&#xEF3C;" FontSize="18" />
                </ToggleButton>
                <Slider x:Name="OpacitySlider" Orientation="Vertical" Height="170" Minimum="1" Maximum="100" StepFrequency="1"
                        IsThumbToolTipEnabled="False" ValueChanged="OpacitySlider_ValueChanged" ToolTipService.ToolTip="Opacidad" />
                <TextBlock x:Name="OpacityLabel" FontSize="11" HorizontalAlignment="Center" Opacity="0.7" />
                <Button x:Name="UndoButton" Style="{StaticResource BarButton}" Click="Undo_Click" ToolTipService.ToolTip="Deshacer (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="18" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource BarButton}" Click="Redo_Click" ToolTipService.ToolTip="Rehacer (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="18" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Hoja inferior para Ajustes y Transformar -->
        <Border x:Name="Sheet" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="560" MaxWidth="900"
                Margin="12,0,12,16" Padding="12" CornerRadius="18" Background="#F21C1D20" BorderBrush="#22FFFFFF" BorderThickness="1">
            <StackPanel Spacing="6">
                <Grid>
                    <Button Content="Cancelar" Click="SheetCancel_Click" />
                    <TextBlock x:Name="SheetTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="Aplicar" Click="SheetApply_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <StackPanel x:Name="SheetBody" Spacing="2" />
            </StackPanel>
        </Border>

        <!-- Arrastre del color para rellenar -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Ellipse x:Name="DropDot" Width="44" Height="44" Stroke="White" StrokeThickness="3" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>
