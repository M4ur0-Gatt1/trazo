<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquete MSIX para la Microsoft Store. Solo se usa al compilar con WindowsPackageType=MSIX
  (tools/build-msix.ps1 y el flujo de publicación). El instalador .exe sigue siendo una app sin empaquetar.
  La identidad (Name, Publisher y PublisherDisplayName) la asigna el Centro de partners al reservar el nombre:
  tools/build-msix.ps1 la sustituye a partir de parámetros o de las variables TRAZO_STORE_*.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="Trazo.Desarrollo" Publisher="CN=Trazo Desarrollo" Version="1.0.0.0" />

  <Properties>
    <DisplayName>Trazo</DisplayName>
    <PublisherDisplayName>Mauro Gatti</PublisherDisplayName>
    <Logo>Assets\Store\StoreLogo.png</Logo>
    <Description>Estudio de pintura digital para Windows, con lápiz y pantalla táctil.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Trazo"
        Description="Estudio de pintura digital para Windows, con lápiz y pantalla táctil."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Store\Square150x150Logo.png"
        Square44x44Logo="Assets\Store\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Store\Wide310x150Logo.png" ShortName="Trazo" />
        <uap:SplashScreen Image="Assets\Store\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
      <Extensions>
        <!-- doble clic en un .trazo abre la app con la ruta como argumento, igual que con el instalador -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="trazo">
            <uap:DisplayName>Proyecto de Trazo</uap:DisplayName>
            <uap:Logo>Assets\Store\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.trazo</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
