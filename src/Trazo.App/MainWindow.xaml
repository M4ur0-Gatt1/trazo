<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Trazo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Trazo.App.Views"
    Title="Trazo">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título propia (la ventana extiende su contenido hasta arriba) -->
        <Grid x:Name="TitleBar" Height="36" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Logo.png" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="Trazo" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
            </StackPanel>
        </Grid>

        <views:GalleryView x:Name="Gallery" Grid.Row="1" />
        <views:StudioView x:Name="Studio" Grid.Row="1" Visibility="Collapsed" />

        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" MaxWidth="560" />
    </Grid>
</Window>
